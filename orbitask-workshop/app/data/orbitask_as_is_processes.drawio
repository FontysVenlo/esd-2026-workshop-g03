<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="p0" name="0 – Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0-auto-t1" value="Orbitask – process landscape (as-is)" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="34" as="geometry"/></mxCell><mxCell id="p0-auto-t2" value="Orbitask is a fast-growing SaaS company (120 employees, ~900 business customers) selling an online project-management tool. The software is modern, but the company itself still runs on email, Excel, Word, copy-paste and phone calls. Management wants to scale without hiring more admin staff.&lt;br&gt;&lt;br&gt;&lt;i&gt;Click a process to open its page (or use the page tabs at the bottom).&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1040" height="70" as="geometry"/></mxCell><mxCell id="p0-auto-b3" value="Management processes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1295" height="180" as="geometry"/></mxCell><UserObject label="P10&lt;br&gt;Monthly management reporting" link="data:page/id,p10" id="p0-P10"><mxCell style="points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;taskMarker=abstract;isLoopSub=1;fontSize=12;strokeWidth=1.5;fontStyle=1;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70