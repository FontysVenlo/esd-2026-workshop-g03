lor=#555555;exitX=0.6091;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-auto-x2" target="p3-c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-auto-n23" value="Half of the forms are incomplete (start date, role, tools)." style="shape=partialRectangle;html=1;whiteSpace=wrap;right=0;fillColor=#FFFDF2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;strokeColor=#888888;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="955.0" y="775" width="150" height="64" as="geometry"/></mxCell><mxCell id="p3-auto-e24" value="" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#999999;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-auto-n23" target="p3-g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-auto-n25" value="AD, Outlook, Jira, Slack, GitHub, HR tool: ~2 h per hire, 8 hires/month." style="shape=partialRectangle;html=1;whiteSpace=wrap;right=0;fillColor=#FFFDF2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;strokeColor=#888888;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1285.0" y="775" width="150" height="64" as="geometry"/></mxCell><mxCell id="p3-auto-e26" value="" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#999999;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-auto-n25" target="p3-t6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-auto-n27" value="Accounts often missing on day 1. Passwords on paper = security risk." style="shape=partialRectangle;html=1;whiteSpace=wrap;right=0;fillColor=#FFFDF2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;strokeColor=#888888;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1780.0" y="775" width="150" height="64" as="geometry"/></mxCell><mxCell 