 style="dashed=1;dashPattern=8 4;endArrow=blockThin;endFill=0;startArrow=oval;startFill=0;endSize=8;startSize=5;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#555555;strokeColor=#555555;exitX=0.7754;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-auto-x2" target="p1-c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-auto-n26" value="~15 min per lead, 40 leads/week. Typos in emails and phone numbers." style="shape=partialRectangle;html=1;whiteSpace=wrap;right=0;fillColor=#FFFDF2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;strokeColor=#888888;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="460.0" y="775" width="150" height="64" as="geometry"/></mxCell><mxCell id="p1-auto-e27" value="" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#999999;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-auto-n26" target="p1-t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-auto-n28" value="Duplicates still slip through: 2 reps sometimes call the same prospect." style="shape=partialRectangle;html=1;whiteSpace=wrap;right=0;fillColor=#FFFDF2;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;strokeColor=#888888;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="625.0" y="775" width="150" height="64" as="geometry"/></mxCell><mxCell id="p1-auto-e29" value="" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#999999;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-auto-n28" target="p1-t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-auto-n30" value="No assignment rule. Some leads are forgotten (~10%)." style="shape=partialRectangle;html=1;whiteSpace=wrap;right=0;fillColor=#FFFDF2;align=left;verticalAlign=middle;spacingLeft=6;